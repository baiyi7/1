# 按稀有度分池
CARDS_BY_R: dict = {}
for _c in CARDS:
    CARDS_BY_R.setdefault(_c["rarity"], []).append(_c)

def draw_one() -> tuple:
    """按概率抽一张卡，返回 (card, rarity)。"""
    r = random.random()
    if r < 0.60:
        rarity = "common"
    elif r < 0.87:
        rarity = "rare"
    elif r < 0.98:
        rarity = "epic"
    else:
        rarity = "legend"
    card = random.choice(CARDS_BY_R[rarity])
    return card, rarity



# ===================== 时间解析 timeparse =====================
"""自然语言时间解析（Python 移植自网页版）。

支持：
  明早9点 / 明晚10点 / 今晚8点 / 后天 / 周五前 / 10月20日前 / 周日前
  下午3点半 / 早上7点 / 22点（配「每天的事」当作每日提醒）
解析不到则退回「种下后 24 小时」。
返回毫秒时间戳（dueAt）或 {h, m}（clock，每天类）。
"""

_MS = 1000


def _now() -> datetime.datetime:
    return datetime.datetime.now()


def _set_hm(h: int, m: int) -> datetime.datetime:
    return _now().replace(hour=h, minute=m, second=0, microsecond=0)


def parse_due(text: str) -> int:
    """解析截止/事件时间，返回毫秒时间戳；解析不到返回 now+24h。"""
    text = text or ""
    now = _now()

    m = re.search(r"明早\s*(\d{1,2})(?:点|：|:)(\d{1,2})?", text)
    if m:
        x = (now + datetime.timedelta(days=1)).replace(
            hour=int(m.group(1)), minute=int(m.group(2)) if m.group(2) else 0,
            second=0, microsecond=0)
        return x.timestamp() * _MS

    m = re.search(r"明(?:天|晚|日)?\s*(?:晚上|夜里|夜)?\s*(\d{1,2})(?:点|：|:)(\d{1,2})?", text)
    if m:
        x = (now + datetime.timedelta(days=1)).replace(
            hour=int(m.group(1)), minute=int(m.group(2)) if m.group(2) else 0,
            second=0, microsecond=0)
        return x.timestamp() * _MS

    m = re.search(r"今晚\s*(\d{1,2})(?:点|：|:)(\d{1,2})?", text)
    if m:
        x = _set_hm(int(m.group(1)), int(m.group(2)) if m.group(2) else 0)
        if x.timestamp() * _MS <= now.timestamp() * _MS:
            x = x + datetime.timedelta(days=1)
        return x.timestamp() * _MS

    m = re.search(r"后天\s*(\d{1,2})?(?:点|：|:)(\d{1,2})?", text)
    if m:
        x = (now + datetime.timedelta(days=2)).replace(
            hour=int(m.group(1)) if m.group(1) else 9,
            minute=int(m.group(2)) if m.group(2) else 0,
            second=0, microsecond=0)
        return x.timestamp() * _MS

    m = re.search(
        r"(\d{1,2})[/月\-\.](\d{1,2})(?:日)?\s*(?:前|之前|前搞定)?\s*(?:(\d{1,2})(?:点|：|:)(\d{1,2})?)?", text)
    if m:
        x = now.replace(
            month=int(m.group(1)), day=int(m.group(2)),
            hour=int(m.group(3)) if m.group(3) else 23,
            minute=int(m.group(4)) if m.group(4) else 59,
            second=0, microsecond=0)
        return x.timestamp() * _MS

    m = re.search(r"周([一二三四五六日天])\s*(?:(\d{1,2})(?:点|：|:)(\d{1,2})?)?", text)
    if m:
        wd = {"一": 1, "二": 2, "三": 3, "四": 4, "五": 5, "六": 6, "日": 0, "天": 0}[m.group(1)]
        diff = (wd - now.weekday() + 7) % 7
        if diff == 0:
            diff = 7
        x = (now + datetime.timedelta(days=diff)).replace(
            hour=int(m.group(2)) if m.group(2) else 9,
            minute=int(m.group(3)) if m.group(3) else 0,
            second=0, microsecond=0)
        return x.timestamp() * _MS

    m = re.search(r"下午\s*(\d{1,2})(?:点|：|:)(\d{1,2})?", text)
    if m:
        h = int(m.group(1)) + 12 if int(m.group(1)) <= 12 else int(m.group(1))
        return _set_hm(h, int(m.group(2)) if m.group(2) else 0).timestamp() * _MS

    m = re.search(r"早上\s*(\d{1,2})(?:点|：|:)(\d{1,2})?", text)
    if m:
        return _set_hm(int(m.group(1)), int(m.group(2)) if m.group(2) else 0).timestamp() * _MS

    m = re.search(r"(\d{1,2})(?:点|：|:)(\d{1,2})?\s*(?:前|之前|搞定|完成)", text)
    if m:
        return _set_hm(int(m.group(1)), int(m.group(2)) if m.group(2) else 0).timestamp() * _MS

    return (now + datetime.timedelta(days=1)).timestamp() * _MS


def parse_clock(text: str):
    """解析「每天的事」的每日提醒时间点，返回 {h, m} 或 None。"""
    text = text or ""
    m = re.search(r"(\d{1,2})\s*点\s*(半|(\d{1,2}))?", text)
    if not m:
        return None
    h = int(m.group(1))
    if h > 23:
        h = 23
    if m.group(2) == "半":
        mm = 30
    elif m.group(3):
        mm = int(m.group(3))
    else:
        mm = 0
    if mm > 59:
        mm = 59
    if re.search(r"下午|晚上|夜里|傍晚", text) and h < 12:
        h += 12
    return {"h": h, "m": mm}



# ===================== 数据模型 models =====================
"""数据模型与持久化（JSON 文件）。

状态结构（与网页版对齐，便于导入旧数据）：
  version / theme / seeds[] / cards{id:{count,firstAt}} /
  stats{totalDraws,totalDone,byRarity} / pullLog[]
"""

# 数据文件放在工程根目录（与 main.py 同级），发送文件夹时一并带走。
_ROOT = os.path.dirname(os.path.abspath(__file__))
DATA_FILE = os.path.join(_ROOT, "gacha_data.json")


def default_state() -> dict:
    return {
        "version": 1,
        "theme": "light",
        "seeds": [],
        "cards": {},
        "stats": {"totalDraws": 0, "totalDone": 0,
                  "byRarity": {"common": 0, "rare": 0, "epic": 0, "legend": 0}},
        "pullLog": [],
    }


def today_str() -> str:
    d = time.localtime()
    return f"{d.tm_year}-{d.tm_mon:02d}-{d.tm_mday:02d}"


def _to_int(v, default=0):
    try:
        return int(v)
    except (TypeError, ValueError):
        return default


def normalize_seed(x: dict) -> dict:
    clock = x.get("clock")
    return {
        "id": str(x.get("id")),
        "text": str(x.get("text", "")),
        "type": x.get("type") if x.get("type") in ("once", "daily", "ddl") else "once",
        "createdAt": _to_int(x.get("createdAt"), int(time.time() * 1000)),
        "dueAt": (_to_int(x["dueAt"]) if x.get("dueAt") is not None else None),
        "clock": ({"h": _to_int(x["clock"]["h"]), "m": _to_int(x["clock"]["m"])}
                  if isinstance(clock, dict) else None),
        "done": bool(x.get("done")),
        "doneAt": (_to_int(x["doneAt"]) if x.get("doneAt") is not None else None),
        "cardId": x.get("cardId") or None,
        "lastDoneDate": (str(x["lastDoneDate"]) if x.get("lastDoneDate") else None),
    }


def normalize(d: dict) -> dict:
    if not isinstance(d, dict):
        return default_state()
    s = default_state()
    if d.get("theme") == "dark":
        s["theme"] = "dark"
    if isinstance(d.get("seeds"), list):
        s["seeds"] = [normalize_seed(x) for x in d["seeds"] if x and x.get("id")]
    cards = d.get("cards")
    if isinstance(cards, dict):
        for cid, v in cards.items():
            if isinstance(v, dict) and _to_int(v.get("count"), 0) > 0:
                s["cards"][cid] = {"count": _to_int(v.get("count"), 1),
                                   "firstAt": _to_int(v.get("firstAt"), int(time.time() * 1000))}
    stats = d.get("stats")
    if isinstance(stats, dict):
        s["stats"]["totalDraws"] = _to_int(stats.get("totalDraws"))
        s["stats"]["totalDone"] = _to_int(stats.get("totalDone"))
        by = stats.get("byRarity") or {}
        for r in ("common", "rare", "epic", "legend"):
            s["stats"]["byRarity"][r] = _to_int(by.get(r))
    if isinstance(d.get("pullLog"), list):
        s["pullLog"] = d["pullLog"][:30]
    return s


class Store:
    """本地存储 + 业务操作。无 GUI 依赖，便于单元测试。"""

    def __init__(self, data_file: str = DATA_FILE):
        self.data_file = data_file
        self.state = default_state()
        self.load()

    # ---------- 持久化 ----------
    def load(self):
        try:
            with open(self.data_file, "r", encoding="utf-8") as f:
                self.state = normalize(json.load(f))
        except (FileNotFoundError, json.JSONDecodeError):
            self.state = default_state()

    def save(self):
        try:
            with open(self.data_file, "w", encoding="utf-8") as f:
                json.dump(self.state, f, ensure_ascii=False, indent=2)
        except OSError:
            pass

    # ---------- 查询 ----------
    def is_done_today(self, s: dict) -> bool:
        if s["type"] == "daily":
            return s["lastDoneDate"] == today_str()
        return s["done"]

    def is_missed(self, s: dict) -> bool:
        return (s["type"] in ("once", "ddl")) and not s["done"] \
            and s["dueAt"] is not None and s["dueAt"] < time.time() * 1000

    def get_seed(self, sid: str):
        return next((x for x in self.state["seeds"] if x["id"] == sid), None)

    # ---------- 操作 ----------
    def add_seed(self, text: str, type_: str, due_at, clock) -> str:
        sid = uuid.uuid4().hex
        self.state["seeds"].insert(0, {
            "id": sid, "text": text, "type": type_,
            "createdAt": int(time.time() * 1000),
            "dueAt": due_at, "clock": clock,
            "done": False, "doneAt": None, "cardId": None, "lastDoneDate": None,
        })
        self.save()
        return sid

    def complete_seed(self, sid: str, draw_fn):
        """完成并抽卡。返回 dict：{'already'} / {'missed'} / {'card','rarity','isNew'}。"""
        s = self.get_seed(sid)
        if not s:
            return None
        if s["type"] == "daily":
            if s["lastDoneDate"] == today_str():
                return {"already": True}
        else:
            if s["dueAt"] and s["dueAt"] < time.time() * 1000:
                return {"missed": True}

        if s["type"] == "daily":
            s["lastDoneDate"] = today_str()
        else:
            s["done"] = True
        s["doneAt"] = int(time.time() * 1000)

        card, rarity = draw_fn()
        is_new = card["id"] not in self.state["cards"]
        if is_new:
            self.state["cards"][card["id"]] = {"count": 0, "firstAt": int(time.time() * 1000)}
        self.state["cards"][card["id"]]["count"] += 1
        self.state["stats"]["totalDraws"] += 1
        self.state["stats"]["totalDone"] += 1
        self.state["stats"]["byRarity"][rarity] += 1
        self.state["pullLog"].insert(0, {
            "at": int(time.time() * 1000), "cardId": card["id"],
            "rarity": rarity, "isNew": is_new,
        })
        self.state["pullLog"] = self.state["pullLog"][:30]
        self.save()
        return {"card": card, "rarity": rarity, "isNew": is_new}

    def remove_seed(self, sid: str):
        self.state["seeds"] = [x for x in self.state["seeds"] if x["id"] != sid]
        self.save()

    # ---------- 数据迁移 ----------
    def export_json(self) -> str:
        return json.dumps(self.state, ensure_ascii=False, indent=2)

    def import_json(self, text: str):
        d = json.loads(text)
        if not isinstance(d, dict) or d.get("version") != 1:
            raise ValueError("无效的数据文件（需 version=1）")
        self.state = normalize(d)
        self.save()

    def clear(self):
        self.state = default_state()
        self.save()

    # ---------- 统计 / 成就 ----------
    def completions_by_day(self, n=14):
        """最近 n 天每天完成的事项数（事件/每天/DDL 完成均计入）。返回 [(date_str, count)] 从旧到新。"""
        buckets = {}
        for s in self.state["seeds"]:
            at = s.get("doneAt")
            if not at:
                if s["type"] == "daily" and s.get("lastDoneDate"):
                    buckets[s["lastDoneDate"]] = buckets.get(s["lastDoneDate"], 0) + 1
                continue
            d = datetime.datetime.fromtimestamp(at / 1000).strftime("%Y-%m-%d")
            buckets[d] = buckets.get(d, 0) + 1
        today = datetime.datetime.now()
        out = []
        for i in range(n - 1, -1, -1):
            d = (today - datetime.timedelta(days=i)).strftime("%Y-%m-%d")
            out.append((d, buckets.get(d, 0)))
        return out

    def type_distribution(self):
        dist = {"once": 0, "daily": 0, "ddl": 0}
        for s in self.state["seeds"]:
            dist[s["type"]] = dist.get(s["type"], 0) + 1
        return dist

    def daily_streak(self):
        """基于「每天」类任务，计算当前连续打卡天数（今天或昨天有完成则计入）。"""
        dates = set()
        for s in self.state["seeds"]:
            if s["type"] == "daily" and s.get("lastDoneDate"):
                dates.add(s["lastDoneDate"])
        if not dates:
            return 0
        streak = 0
        d = datetime.datetime.now()
        if d.strftime("%Y-%m-%d") not in dates:
            d -= datetime.timedelta(days=1)
        while d.strftime("%Y-%m-%d") in dates:
            streak += 1
            d -= datetime.timedelta(days=1)
        return streak

    def achievements(self):
        cards = self.state["cards"]
        stats = self.state["stats"]
        total = len(cards)

        def _got(rarity):
            return sum(1 for c in CARDS if c["rarity"] == rarity and c["id"] in cards)

        def _all(rarity):
            return sum(1 for c in CARDS if c["rarity"] == rarity)

        streak = self.daily_streak()
        got_c, all_c = _got("common"), _all("common")
        got_r, all_r = _got("rare"), _all("rare")
        got_e, all_e = _got("epic"), _all("epic")
        got_l, all_l = _got("legend"), _all("legend")
        return [
            ("初次抽卡", "完成第一件事并抽到卡", stats["totalDraws"] >= 1),
            ("小有所成", "累计完成 10 件事", stats["totalDone"] >= 10),
            ("渐入佳境", "累计完成 30 件事", stats["totalDone"] >= 30),
            ("自律达人", "累计完成 100 件事", stats["totalDone"] >= 100),
            ("七日不断", "连续打卡 7 天", streak >= 7),
            ("三十日功", "连续打卡 30 天", streak >= 30),
            ("普通集齐", f"普通卡 {got_c}/{all_c}", got_c >= all_c and all_c > 0),
            ("稀有猎手", f"稀有卡 {got_r}/{all_r}", got_r >= all_r and all_r > 0),
            ("史诗收藏", f"史诗卡 {got_e}/{all_e}", got_e >= all_e and all_e > 0),
            ("传说降临", f"传说卡 {got_l}/{all_l}", got_l >= all_l and all_l > 0),
            ("图鉴大成", f"集齐全部 {total}/{len(CARDS)} 张", total >= len(CARDS)),
        ]



