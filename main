def load_card_pixmap(card_id: str, size: int):
    data = CARD_B64.get(card_id)
    if not data:
        return None
    pm = QPixmap()
    pm.loadFromData(QByteArray.fromBase64(data.encode("ascii")))
    return pm.scaled(size, size, Qt.AspectRatioMode.KeepAspectRatio,
                     Qt.TransformationMode.SmoothTransformation)


def _fmt_time(ts):
    d = time.localtime(ts / 1000)
    return f"{d.tm_mon}/{d.tm_mday} {d.tm_hour:02d}:{d.tm_min:02d}"


def _fmt_countdown(ts):
    rem = ts - time.time() * 1000
    if rem <= 0:
        return "已过期"
    rem = int(rem / 1000)
    h, m = divmod(rem, 3600)
    mm, s = divmod(m, 60)
    if h > 0:
        return f"剩 {h}时{mm}分"
    if mm > 0:
        return f"剩 {mm}分{s}秒"
    return f"剩 {s}秒"


def _fmt_clock(clock):
    if not clock:
        return "每天 · 随时"
    return f"每天 {clock['h']:02d}:{clock['m']:02d}"


class FlipLabel(QLabel):
    """带翻面淡入的卡片展示：先显示卡背，再淡出切换到正面。"""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self._opacity = 1.0
        self.eff = QGraphicsOpacityEffect(self)
        self.setGraphicsEffect(self.eff)
        self.eff.setOpacity(1.0)

    def reveal(self, pixmap, delay_ms=550):
        # 先放卡背
        self.setPixmap(_card_back(200))
        QTimer.singleShot(delay_ms, lambda: self._show_front(pixmap))

    def _show_front(self, pixmap):
        self.setPixmap(pixmap)
        self.eff.setOpacity(0.0)
        anim = QPropertyAnimation(self.eff, b"opacity")
        anim.setDuration(360)
        anim.setStartValue(0.0)
        anim.setEndValue(1.0)
        anim.setEasingCurve(QEasingCurve.Type.OutCubic)
        anim.start()
        self._anim = anim


def _card_back(size: int) -> QPixmap:
    pm = QPixmap(size, size)
    pm.fill(Qt.GlobalColor.transparent)
    p = QPainter(pm)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    p.setBrush(QBrush(QColor("#2b2f36")))
    p.setPen(QPen(QColor(VERMILION), 3))
    p.drawRoundedRect(6, 6, size - 12, size - 12, 16, 16)
    p.setPen(QPen(QColor(VERMILION), 4))
    p.setFont(QFont("KaiTi", int(size * 0.5)))
    p.drawText(pm.rect(), Qt.AlignmentFlag.AlignCenter, "？")
    p.end()
    return pm


class ParticleBurst(QWidget):
    """传说卡金光粒子爆发（覆盖在对话框上的装饰层）。"""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setAttribute(Qt.WidgetAttribute.WA_TransparentForMouseEvents)
        self.setAttribute(Qt.WidgetAttribute.WA_NoBackground, False)
        self.particles = []
        self.timer = QTimer(self)
        self.timer.timeout.connect(self._tick)
        self.t = 0
        self.setStyleSheet("background: transparent;")

    def start(self):
        cx, cy = self.width() / 2, self.height() / 2
        for _ in range(16):
            ang = random.uniform(0, 6.283)
            spd = random.uniform(120, 300)
            self.particles.append({
                "x": cx, "y": cy,
                "vx": spd * 0.6 * (1 if random.random() > 0.5 else -1) * random.uniform(0.4, 1),
                "vy": -abs(spd) * random.uniform(0.4, 1) - 60,
                "life": random.uniform(0.6, 1.0),
                "size": random.uniform(10, 22),
            })
        self.t = 0
        self.timer.start(16)

    def _tick(self):
        self.t += 0.016
        for pt in self.particles:
            pt["x"] += pt["vx"] * 0.016
            pt["y"] += pt["vy"] * 0.016
            pt["vy"] += 240 * 0.016  # 重力
        if self.t > 1.1:
            self.timer.stop()
            self.hide()
        self.update()

    def paintEvent(self, event: QPaintEvent):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        for pt in self.particles:
            life = max(0, 1 - self.t / 1.1)
            if life <= 0:
                continue
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(QBrush(QColor(245, 200, 90, int(220 * life))))
            r = pt["size"] * life
            p.drawEllipse(int(pt["x"] - r / 2), int(pt["y"] - r / 2), int(r), int(r))
        p.end()


class DrawDialog(QDialog):
    """抽卡结果弹窗：卡背淡出 → 正面翻入；传说额外金光。"""

    def __init__(self, card, rarity, is_new, theme, parent=None):
        super().__init__(parent)
        self.setWindowTitle("抽卡")
        self.setMinimumSize(320, 420)
        self.setStyleSheet("QDialog { background: #f3ead7; }" if theme == "light"
                           else "QDialog { background: #1b2027; }")
        lay = QVBoxLayout(self)
        lay.setAlignment(Qt.AlignmentFlag.AlignCenter)

        self.flip = FlipLabel()
        self.flip.setFixedSize(220, 220)
        lay.addWidget(self.flip, alignment=Qt.AlignmentFlag.AlignCenter)

        ribbon = QLabel(f"{gacha.RARITY[rarity]['label']}"
                        + (" · 新收录！" if is_new else ""))
        ribbon.setAlignment(Qt.AlignmentFlag.AlignCenter)
        ribbon.setStyleSheet(f"font-size:18px;font-weight:bold;color:{RARITY_STYLE[rarity]};"
                             f"padding:6px;")
        lay.addWidget(ribbon)

        name = QLabel(card["name"])
        name.setAlignment(Qt.AlignmentFlag.AlignCenter)
        name.setStyleSheet("font-size:22px;font-weight:bold;")
        lay.addWidget(name)

        desc = QLabel(card["desc"])
        desc.setAlignment(Qt.AlignmentFlag.AlignCenter)
        desc.setWordWrap(True)
        desc.setStyleSheet("color:#8a7c66;font-size:14px;padding:4px 20px;")
        lay.addWidget(desc)

        close_btn = QPushButton("收下")
        close_btn.setProperty("class", "primary")
        close_btn.clicked.connect(self.accept)
        lay.addWidget(close_btn, alignment=Qt.AlignmentFlag.AlignCenter)

        pm = load_card_pixmap(card["id"], 200)
        if pm is None:
            pm = QPixmap(200, 200)
            pm.fill(Qt.GlobalColor.transparent)
        self.flip.reveal(pm, delay_ms=500)

        if rarity == "legend":
            self.burst = ParticleBurst(self)
            self.burst.setGeometry(0, 0, self.width(), self.height())
            self.burst.raise_()

    def resizeEvent(self, event):
        if hasattr(self, "burst"):
            self.burst.setGeometry(0, 0, self.width(), self.height())
        super().resizeEvent(event)

    def showEvent(self, event):
        if hasattr(self, "burst"):
            self.burst.start()
        super().showEvent(event)


class TaskCard(QFrame):
    def __init__(self, seed, on_complete, on_delete):
        super().__init__()
        self.seed = seed
        self.setProperty("class", "panel")
        self.setStyleSheet("QFrame[class='panel'] { padding: 12px; }")
        v = QVBoxLayout(self)
        v.setContentsMargins(12, 12, 12, 12)

        top = QHBoxLayout()
        tag = QLabel(TYPE[seed["type"]]["label"])
        tag.setStyleSheet(f"background:{TYPE[seed['type']]['color']};color:#fff;"
                          f"border-radius:6px;padding:2px 10px;font-size:13px;")
        top.addWidget(tag)
        top.addStretch(1)
        del_btn = QPushButton("✕")
        del_btn.setFixedSize(28, 28)
        del_btn.clicked.connect(lambda: on_delete(seed["id"]))
        top.addWidget(del_btn)
        v.addLayout(top)

        self.text_lbl = QLabel(seed["text"])
        self.text_lbl.setWordWrap(True)
        self.text_lbl.setStyleSheet("font-size:16px;")
        v.addWidget(self.text_lbl)

        bottom = QHBoxLayout()
        self.time_lbl = QLabel()
        self.time_lbl.setStyleSheet("font-size:13px;color:#8a7c66;")
        bottom.addWidget(self.time_lbl)
        bottom.addStretch(1)
        comp = QPushButton("完成并抽卡")
        comp.setProperty("class", "primary")
        comp.clicked.connect(lambda: on_complete(seed["id"]))
        bottom.addWidget(comp)
        v.addLayout(bottom)

        self.refresh()

    def refresh(self):
        s = self.seed
        if s["type"] == "daily":
            self.time_lbl.setText(_fmt_clock(s["clock"]))
        else:
            self.time_lbl.setText(_fmt_time(s["dueAt"]) + "  " + _fmt_countdown(s["dueAt"]))
        missed = (s["type"] in ("once", "ddl")) and not s["done"] and \
            s["dueAt"] is not None and s["dueAt"] < time.time() * 1000
        done = models_store_is_done(self.seed)
        if missed:
            self.setStyleSheet("QFrame[class='panel'] { padding:12px;border:2px solid #ef4444; }")
            self.time_lbl.setText("错过抽卡（机会溜走了）")
            self.time_lbl.setStyleSheet("font-size:13px;color:#ef4444;")
        elif done:
            self.setStyleSheet("QFrame[class='panel'] { padding:12px;border:2px solid #22c55e; }")
        else:
            self.setStyleSheet("QFrame[class='panel'] { padding:12px; }")


def models_store_is_done(seed):
    if seed["type"] == "daily":
        return seed["lastDoneDate"] == models.today_str()
    return seed["done"]


class HomePage(QWidget):
    def __init__(self, store, refresh_all):
        super().__init__()
        self.store = store
        self.refresh_all = refresh_all
        self.current_type = "once"
        self.card_refs = {}

        v = QVBoxLayout(self)
        v.setContentsMargins(20, 20, 20, 20)

        # 类型选择
        seg = QHBoxLayout()
        self.tbtns = {}
        for t, cfg in TYPE.items():
            b = QPushButton(cfg["label"])
            b.setProperty("class", "tbtn")
            b.clicked.connect(lambda _, t=t: self.set_type(t))
            self.tbtns[t] = b
            seg.addWidget(b)
        v.addLayout(seg)

        # 今日概览横幅
        self.banner = QLabel()
        self.banner.setStyleSheet('font-size:15px;color:#b3402f;font-weight:bold;padding:2px 4px;')
        v.addWidget(self.banner)

        # 输入行
        row = QHBoxLayout()
        self.input = QLineEdit()
        self.input.setPlaceholderText("写下想做的事，如：明早9点 交表 / 每天 背单词")
        self.input.returnPressed.connect(self.add_seed)
        row.addWidget(self.input, 3)
        add_btn = QPushButton("种下")
        add_btn.setProperty("class", "primary")
        add_btn.clicked.connect(self.add_seed)
        row.addWidget(add_btn, 1)
        v.addLayout(row)

        # 任务列表
        self.scroll = QScrollArea()
        self.scroll.setWidgetResizable(True)
        self.list_widget = QWidget()
        self.list_layout = QVBoxLayout(self.list_widget)
        self.list_layout.setAlignment(Qt.AlignmentFlag.AlignTop)
        self.scroll.setWidget(self.list_widget)
        v.addWidget(self.scroll, 1)

        self.set_type("once")

        # 每秒刷新倒计时
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.tick)
        self.timer.start(1000)

    def set_type(self, t):
        self.current_type = t
        for k, b in self.tbtns.items():
            b.setProperty("active", "true" if k == t else "false")
            b.style().polish(b)

    def add_seed(self):
        text = self.input.text().strip()
        if not text:
            return
        if self.current_type == "daily":
            due = None
            clock = timeparse.parse_clock(text)
        else:
            due = timeparse.parse_due(text)
            clock = None
        self.store.add_seed(text, self.current_type, due, clock)
        self.input.clear()
        self.rebuild()
        self.refresh_all()

    def rebuild(self):
        # 清空旧卡片
        for i in reversed(range(self.list_layout.count())):
            w = self.list_layout.itemAt(i).widget()
            if w:
                w.setParent(None)
        self.card_refs.clear()
        self.banner.setText(self._banner_text())
        if not self.store.state["seeds"]:
            hint = QLabel("还没有念头，写下第一件想做的事，种下它 ✦")
            hint.setStyleSheet("color:#8a7c66;font-size:15px;padding:20px;")
            self.list_layout.addWidget(hint)
            return
        for s in self.store.state["seeds"]:
            card = TaskCard(s, self.on_complete, self.on_delete)
            self.card_refs[s["id"]] = card
            self.list_layout.addWidget(card)

    def _banner_text(self):
        today = today_str()
        done_today = 0
        for s in self.store.state["seeds"]:
            if s.get("doneAt"):
                if datetime.datetime.fromtimestamp(s["doneAt"] / 1000).strftime("%Y-%m-%d") == today:
                    done_today += 1
            elif s["type"] == "daily" and s.get("lastDoneDate") == today:
                done_today += 1
        streak = self.store.daily_streak()
        return "今日已完成 " + str(done_today) + " 件 · 连续打卡 " + str(streak) + " 天"

    def tick(self):
        for sid, card in self.card_refs.items():
            card.refresh()

    def on_complete(self, sid):
        res = self.store.complete_seed(sid, gacha.draw_one)
        if res is None:
            return
        if res.get("already"):
            QMessageBox.information(self, "提示", "今天的抽卡已经完成啦，明天再来~")
            return
        if res.get("missed"):
            QMessageBox.information(self, "提示", "已经错过截止，这次机会溜走了…")
            self.rebuild()
            return
        self.rebuild()
        self.refresh_all()
        dlg = DrawDialog(res["card"], res["rarity"], res["isNew"], self.store.state["theme"], self)
        dlg.exec()

    def on_delete(self, sid):
        self.store.remove_seed(sid)
        self.rebuild()
        self.refresh_all()


class CodexPage(QWidget):
    def __init__(self, store):
        super().__init__()
        self.store = store
        v = QVBoxLayout(self)
        v.setContentsMargins(20, 20, 20, 20)

        self.progress = QLabel()
        self.progress.setStyleSheet("font-size:15px;padding-bottom:8px;")
        v.addWidget(self.progress)

        grid = QGridLayout()
        grid.setSpacing(10)
        self.cells = {}
        positions = [(i // 6, i % 6) for i in range(26)]
        for (card, pos) in zip(gacha.CARDS, positions):
            cell = self._make_cell(card)
            self.cells[card["id"]] = cell
            grid.addWidget(cell, *pos)
        v.addLayout(grid)

    def _make_cell(self, card):
        frame = QFrame()
        frame.setFixedSize(120, 140)
        frame.setProperty("class", "panel")
        lay = QVBoxLayout(frame)
        lay.setContentsMargins(6, 6, 6, 6)
        img = QLabel()
        img.setAlignment(Qt.AlignmentFlag.AlignCenter)
        pm = load_card_pixmap(card["id"], 90)
        if pm:
            img.setPixmap(pm)
        else:
            img.setText("？")
            img.setStyleSheet("font-size:40px;color:#9aa0a6;")
        lay.addWidget(img)
        name = QLabel(card["name"])
        name.setAlignment(Qt.AlignmentFlag.AlignCenter)
        name.setStyleSheet(f"font-size:13px;color:{RARITY_STYLE[card['rarity']]};")
        lay.addWidget(name)
        return frame

    def refresh(self):
        owned = set(self.store.state["cards"].keys())
        self.progress.setText(self._progress_text(owned))
        for cid, frame in self.cells.items():
            img = frame.findChild(QLabel)
            if cid in owned and img and img.text() == "？":
                pm = load_card_pixmap(cid, 90)
                if pm:
                    img.setPixmap(pm)
                    img.setText("")

    def _progress_text(self, owned):
        parts = []
        for r in ("common", "rare", "epic", "legend"):
            total = len(gacha.CARDS_BY_R[r])
            got = sum(1 for c in gacha.CARDS_BY_R[r] if c["id"] in owned)
            parts.append(f"{gacha.RARITY[r]['label']} {got}/{total}")
        allgot = len(owned)
        return f"收集进度 {allgot}/26　|　" + "　".join(parts)


class DataPage(QWidget):
    def __init__(self, store, refresh_all):
        super().__init__()
        self.store = store
        self.refresh_all = refresh_all
        v = QVBoxLayout(self)
        v.setContentsMargins(20, 20, 20, 20)
        v.setAlignment(Qt.AlignmentFlag.AlignTop)

        title = QLabel("数据")
        title.setStyleSheet("font-size:20px;font-weight:bold;")
        v.addWidget(title)

        self.stat_lbl = QLabel()
        self.stat_lbl.setWordWrap(True)
        self.stat_lbl.setStyleSheet("font-size:15px;padding:10px 0;")
        v.addWidget(self.stat_lbl)

        row = QHBoxLayout()
        exp = QPushButton("导出 JSON")
        exp.clicked.connect(self.export_data)
        imp = QPushButton("导入 JSON")
        imp.clicked.connect(self.import_data)
        clr = QPushButton("清空数据")
        clr.clicked.connect(self.clear_data)
        row.addWidget(exp)
        row.addWidget(imp)
        row.addWidget(clr)
        v.addLayout(row)

        v.addWidget(QLabel("或粘贴 JSON 后点「载入」："))
        self.paste = QLineEdit()
        v.addWidget(self.paste)
        load_btn = QPushButton("载入")
        load_btn.setProperty("class", "primary")
        load_btn.clicked.connect(self.load_paste)
        v.addWidget(load_btn)

        self.refresh()

    def refresh(self):
        s = self.store.state["stats"]
        by = s["byRarity"]
        self.stat_lbl.setText(
            f"累计抽卡 {s['totalDraws']} 次　完成 {s['totalDone']} 件\n"
            f"普通 {by['common']}　稀有 {by['rare']}　史诗 {by['epic']}　传说 {by['legend']}")

    def export_data(self):
        path, _ = QFileDialog.getSaveFileName(self, "导出数据", "gacha_backup.json", "JSON (*.json)")
        if path:
            with open(path, "w", encoding="utf-8") as f:
                f.write(self.store.export_json())
            QMessageBox.information(self, "已导出", f"已保存到：{path}")

    def import_data(self):
        path, _ = QFileDialog.getOpenFileName(self, "导入数据", "", "JSON (*.json)")
        if not path:
            return
        try:
            with open(path, "r", encoding="utf-8") as f:
                self.store.import_json(f.read())
            self.refresh()
            self.refresh_all()
            QMessageBox.information(self, "已导入", "数据已载入。")
        except Exception as e:
            QMessageBox.warning(self, "导入失败", str(e))

    def load_paste(self):
        text = self.paste.text().strip()
        if not text:
            return
        try:
            self.store.import_json(text)
            self.refresh()
            self.refresh_all()
            QMessageBox.information(self, "已载入", "数据已载入。")
        except Exception as e:
            QMessageBox.warning(self, "载入失败", str(e))

    def clear_data(self):
        if QMessageBox.question(self, "确认清空", "会删除所有任务与图鉴，确定吗？",
                                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No) \
                == QMessageBox.StandardButton.Yes:
            self.store.clear()
            self.refresh()
            self.refresh_all()


STATS_PALETTES = {
    'light': {'panel': '#fbf6ea', 'ink': '#3a3226', 'muted': '#8a7c66', 'grid': '#e3d8c2',
              'accent': '#b3402f', 'common': '#9aa0a6', 'rare': '#3b82f6', 'epic': '#a855f7',
              'legend': '#f59e0b'},
    'dark': {'panel': '#262c34', 'ink': '#e8e2d4', 'muted': '#9aa3ad', 'grid': '#3a424c',
             'accent': '#d96b54', 'common': '#7f868c', 'rare': '#5b9bff', 'epic': '#c98bff',
             'legend': '#f7b955'},
}


class ChartWidget(QWidget):
    '''用 QPainter 自绘水墨风图表：line 折线 / pie 饼图 / bar 条形。零额外依赖。'''
    def __init__(self, mode='line', parent=None):
        super().__init__(parent)
        self.mode = mode
        self.items = []
        self.pal = STATS_PALETTES['light']
        self.setMinimumHeight(180)
        self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)

    def set_palette(self, pal):
        self.pal = pal
        self.update()

    def set_items(self, items):
        self.items = items
        self.update()

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        w, h = self.width(), self.height()
        p.fillRect(self.rect(), QColor(self.pal['panel']))
        p.setPen(QPen(QColor(self.pal['grid'])))
        p.drawRoundedRect(1, 1, w - 2, h - 2, 10, 10)
        if not self.items:
            p.setPen(QColor(self.pal['muted']))
            p.drawText(self.rect(), Qt.AlignmentFlag.AlignCenter, '暂无数据')
            return
        if self.mode == 'line':
            self._line(p, w, h)
        elif self.mode == 'pie':
            self._pie(p, w, h)
        else:
            self._bar(p, w, h)

    def _line(self, p, w, h):
        data = self.items
        maxv = max((v for _, v in data), default=0)
        maxv = max(maxv, 1)
        pl, pr, pt, pb = 34, 12, 16, 26
        pw, ph = w - pl - pr, h - pt - pb
        n = len(data)
        p.setPen(QPen(QColor(self.pal['grid'])))
        for i in range(4):
            y = pt + ph * i / 3
            p.drawLine(QLineF(pl, y, w - pr, y))
        pts = []
        for i, (label, val) in enumerate(data):
            x = pl + pw * i / max(n - 1, 1)
            y = pt + ph * (1 - val / maxv)
            pts.append((x, y))
        if pts:
            fill = QColor(self.pal['accent']); fill.setAlpha(40)
            poly = [QPointF(pl, pt + ph)] + [QPointF(x, y) for x, y in pts] + [QPointF(pl + pw, pt + ph)]
            p.setBrush(QBrush(fill)); p.setPen(Qt.PenStyle.NoPen)
            p.drawPolygon(QPolygonF(poly))
        p.setPen(QPen(QColor(self.pal['accent']), 2.5))
        for i in range(1, len(pts)):
            a, b = pts[i - 1], pts[i]
            p.drawLine(QLineF(a[0], a[1], b[0], b[1]))
        p.setPen(QColor(self.pal['ink']))
        for i, (label, val) in enumerate(data):
            x, y = pts[i]
            p.setBrush(QBrush(QColor(self.pal['accent'])))
            p.drawEllipse(QPointF(x, y), 3, 3)
            if i % max(1, n // 7) == 0 or i == n - 1:
                p.setPen(QColor(self.pal['muted']))
                p.drawText(QRectF(x - 20, h - 22, 40, 16), Qt.AlignmentFlag.AlignCenter, label[5:])
                p.setPen(QColor(self.pal['ink']))

    def _pie(self, p, w, h):
        items = [(l, v, c) for (l, v, c) in self.items if v > 0]
        total = sum(v for _, v, _ in items)
        if total <= 0:
            p.setPen(QColor(self.pal['muted']))
            p.drawText(self.rect(), Qt.AlignmentFlag.AlignCenter, '暂无数据')
            return
        cx, cy, r = w * 0.30, h / 2, min(w * 0.26, h * 0.40)
        start = 0.0
        for label, val, color in items:
            ang = 360 * val / total
            p.setBrush(QBrush(QColor(color))); p.setPen(Qt.PenStyle.NoPen)
            p.drawPie(QRectF(cx - r, cy - r, r * 2, r * 2), int(start * 16), int(ang * 16))
            start += ang
        lx, ly = w * 0.60, h / 2 - len(items) * 11
        p.setPen(QColor(self.pal['ink']))
        for label, val, color in items:
            p.setBrush(QBrush(QColor(color)))
            p.drawRect(QRectF(lx, ly, 12, 12))
            p.setPen(QColor(self.pal['ink']))
            p.drawText(QRectF(lx + 18, ly - 2, w - lx - 20, 16),
                       Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter, label + ' ' + str(val))
            ly += 22

    def _bar(self, p, w, h):
        items = self.items
        maxv = max((v for _, v in items), default=0)
        maxv = max(maxv, 1)
        pl, pr, pt, pb = 40, 12, 14, 14
        pw, ph = w - pl - pr, h - pt - pb
        n = len(items)
        bw = pw / n
        for i, (label, val) in enumerate(items):
            bh = ph * val / maxv
            x = pl + bw * i + bw * 0.2
            y = pt + ph - bh
            color = TYPE.get(label, {}).get('color', self.pal['accent'])
            p.setBrush(QBrush(QColor(color)))
            p.setPen(Qt.PenStyle.NoPen)
            p.drawRoundedRect(QRectF(x, y, bw * 0.6, bh), 4, 4)
            p.setPen(QColor(self.pal['ink']))
            p.drawText(QRectF(x - bw * 0.2, y - 16, bw, 14), Qt.AlignmentFlag.AlignCenter, str(val))
            p.setPen(QColor(self.pal['muted']))
            p.drawText(QRectF(x - bw * 0.2, pt + ph + 2, bw, 14), Qt.AlignmentFlag.AlignCenter,
                       TYPE.get(label, {}).get('label', label))


class StatsPage(QWidget):
    def __init__(self, store, refresh_all):
        super().__init__()
        self.store = store
        self.refresh_all = refresh_all
        self.pal = STATS_PALETTES[store.state['theme']]
        v = QVBoxLayout(self)
        v.setContentsMargins(18, 16, 18, 16)
        v.setSpacing(14)
        self.cards = {}
        card_row = QHBoxLayout()
        card_row.setSpacing(12)
        for key in ('done', 'streak', 'codex', 'legend'):
            box = self._card(key)
            self.cards[key] = box
            card_row.addWidget(box)
        v.addLayout(card_row)
        charts = QHBoxLayout()
        charts.setSpacing(12)
        self.line_chart = ChartWidget('line')
        self.pie_chart = ChartWidget('pie')
        for c in (self.line_chart, self.pie_chart):
            c.setMinimumHeight(190)
            charts.addWidget(c)
        v.addLayout(charts)
        self.bar_chart = ChartWidget('bar')
        self.bar_chart.setMinimumHeight(150)
        v.addWidget(self.bar_chart)
        v.addWidget(QLabel('成就徽章'))
        self.ach_grid = QGridLayout()
        self.ach_grid.setSpacing(10)
        v.addLayout(self.ach_grid)
        v.addStretch(1)
        self.refresh()

    def _card(self, key):
        box = QFrame()
        box.setProperty('class', 'panel')
        layout = QVBoxLayout(box)
        layout.setContentsMargins(12, 10, 12, 10)
        titles = {'done': '累计完成', 'streak': '连续打卡', 'codex': '图鉴收集', 'legend': '传说卡'}
        title = QLabel(titles[key])
        title.setProperty('class', 'muted')
        big = QLabel('0')
        big.setStyleSheet('font-size:26px;font-weight:bold;color:#b3402f;')
        layout.addWidget(title)
        layout.addWidget(big)
        box._big = big
        return box

    def refresh(self):
        self.pal = STATS_PALETTES[self.store.state['theme']]
        for c in (self.line_chart, self.pie_chart, self.bar_chart):
            c.set_palette(self.pal)
        st = self.store.state['stats']
        total = len(self.store.state['cards'])
        got_l = sum(1 for c in CARDS if c['rarity'] == 'legend' and c['id'] in self.store.state['cards'])
        self.cards['done']._big.setText(str(st['totalDone']))
        self.cards['streak']._big.setText(str(self.store.daily_streak()))
        self.cards['codex']._big.setText(str(total) + '/' + str(len(CARDS)))
        self.cards['legend']._big.setText(str(got_l))
        self.line_chart.set_items(self.store.completions_by_day(14))
        byr = st['byRarity']
        self.pie_chart.set_items([
            ('普通', byr['common'], self.pal['common']),
            ('稀有', byr['rare'], self.pal['rare']),
            ('史诗', byr['epic'], self.pal['epic']),
            ('传说', byr['legend'], self.pal['legend']),
        ])
        td = self.store.type_distribution()
        self.bar_chart.set_items([('once', td['once']), ('daily', td['daily']), ('ddl', td['ddl'])])
        self._achievements()

    def _achievements(self):
        while self.ach_grid.count():
            item = self.ach_grid.takeAt(0)
            w = item.widget()
            if w:
                w.deleteLater()
        cols = 4
        for i, (name, desc, ok) in enumerate(self.store.achievements()):
            cell = QFrame()
            cell.setProperty('class', 'panel')
            cl = QVBoxLayout(cell)
            cl.setContentsMargins(10, 8, 10, 8)
            badge = QLabel('🏅' if ok else '🔒')
            badge.setStyleSheet('font-size:22px;')
            badge.setAlignment(Qt.AlignmentFlag.AlignCenter)
            nm = QLabel(name)
            color = '#b3402f' if ok else self.pal['muted']
            nm.setStyleSheet('font-weight:bold;color:' + color + ';')
            nm.setAlignment(Qt.AlignmentFlag.AlignCenter)
            ds = QLabel(desc)
            ds.setProperty('class', 'muted')
            ds.setWordWrap(True)
            ds.setAlignment(Qt.AlignmentFlag.AlignCenter)
            cl.addWidget(badge); cl.addWidget(nm); cl.addWidget(ds)
            self.ach_grid.addWidget(cell, i // cols, i % cols)


class MainWindow(QMainWindow):
    def __init__(self, store):
        super().__init__()
        self.store = store
        self.setWindowTitle("芽芽 · 抽卡打卡")
        self.resize(720, 760)

        # 顶部导航
        top = QWidget()
        top.setFixedHeight(56)
        th = QHBoxLayout(top)
        th.setContentsMargins(16, 8, 16, 8)
        brand = QLabel("芽芽 · 抽卡打卡")
        brand.setStyleSheet("font-size:20px;font-weight:bold;color:#b3402f;")
        th.addWidget(brand)
        # 朱砂印章
        seal = QLabel("戒")
        seal.setFixedSize(34, 34)
        seal.setAlignment(Qt.AlignmentFlag.AlignCenter)
        seal.setStyleSheet("background:#b3402f;color:#fff7ef;border-radius:6px;"
                           "font-size:18px;font-weight:bold;")
        th.addWidget(seal)
        th.addStretch(1)
        self.theme_btn = QPushButton("🌙 暗色")
        self.theme_btn.clicked.connect(self.toggle_theme)
        th.addWidget(self.theme_btn)

        nav = QWidget()
        nh = QHBoxLayout(nav)
        nh.setContentsMargins(16, 0, 16, 8)
        self.nav_btns = {}
        for key, label in (("home", "主页"), ("stats", "统计"), ("codex", "图鉴"), ("data", "数据")):
            b = QPushButton(label)
            b.setProperty("class", "tbtn")
            b.clicked.connect(lambda _, k=key: self.switch(k))
            self.nav_btns[key] = b
            nh.addWidget(b)

        # 中央堆叠
        self.stack = QStackedWidget()
        self.home = HomePage(store, self.refresh_all)
        self.stats = StatsPage(store, self.refresh_all)
        self.codex = CodexPage(store)
        self.data = DataPage(store, self.refresh_all)
        self.stack.addWidget(self.home)
        self.stack.addWidget(self.stats)
        self.stack.addWidget(self.codex)
        self.stack.addWidget(self.data)

        root = QWidget()
        rv = QVBoxLayout(root)
        rv.setContentsMargins(0, 0, 0, 0)
        rv.addWidget(top)
        rv.addWidget(nav)
        rv.addWidget(self.stack, 1)
        self.setCentralWidget(root)

        self.apply_theme(store.state["theme"])
        self.switch("home")

    def apply_theme(self, theme):
        self.store.state["theme"] = theme
        QApplication.instance().setStyleSheet(THEMES[theme])
        if theme == "light":
            self.theme_btn.setText("🌙 暗色")
        else:
            self.theme_btn.setText("☀️ 亮色")
        self.store.save()

    def toggle_theme(self):
        self.apply_theme("dark" if self.store.state["theme"] == "light" else "light")

    def switch(self, key):
        idx = {"home": 0, "stats": 1, "codex": 2, "data": 3}[key]
        self.stack.setCurrentIndex(idx)
        for k, b in self.nav_btns.items():
            b.setProperty("active", "true" if k == key else "false")
            b.style().polish(b)
        if key == "home":
            self.home.rebuild()
        elif key == "stats":
            self.stats.refresh()
        elif key == "codex":
            self.codex.refresh()
        elif key == "data":
            self.data.refresh()

    def refresh_all(self):
        self.codex.refresh()
        self.data.refresh()


# ===================== 入口 main =====================
def main():
    app = QApplication(sys.argv)
    app.setApplicationName("芽芽 · 抽卡打卡")

    store = Store()
    window = MainWindow(store)
    window.show()

    sys.exit(app.exec())


if __name__ == "__main__":
    main()
