# ============================================================ 光学内核


# ---------------------------------------------------------------- 向量

def add(a, b):
    return (a[0] + b[0], a[1] + b[1])


def sub(a, b):
    return (a[0] - b[0], a[1] - b[1])


def scale(a, s):
    return (a[0] * s, a[1] * s)


def dot(a, b):
    return a[0] * b[0] + a[1] * b[1]


def cross(a, b):
    return a[0] * b[1] - a[1] * b[0]


def norm(a):
    l = math.hypot(a[0], a[1]) or 1.0
    return (a[0] / l, a[1] / l)


def rotate(v, ang):
    c, s = math.cos(ang), math.sin(ang)
    return (v[0] * c - v[1] * s, v[0] * s + v[1] * c)


def from_deg(d):
    r = math.radians(d)
    return (math.cos(r), math.sin(r))


def to_deg(v):
    return math.degrees(math.atan2(v[1], v[0]))


def reflect(d, n):
    """反射定律 r = d - 2(d·n)n"""
    k = 2 * dot(d, n)
    return norm((d[0] - k * n[0], d[1] - k * n[1]))


def ray_seg(ro, rd, a, b):
    """射线与线段求交，返回 (t, 交点, 法线) 或 None"""
    v1, v2 = sub(ro, a), sub(b, a)
    den = cross(rd, v2)
    if abs(den) < 1e-9:
        return None
    t = -cross(v1, v2) / den
    u = -cross(v1, rd) / den
    if t > 1e-6 and 0 <= u <= 1:
        p = add(ro, scale(rd, t))
        return t, p, norm((-v2[1], v2[0]))
    return None


def ray_circle(ro, rd, c, r):
    """射线与圆求交，返回最近正 t 或 None"""
    oc = sub(ro, c)
    b = dot(oc, rd)
    cc = dot(oc, oc) - r * r
    disc = b * b - cc
    if disc < 0:
        return None
    s = math.sqrt(disc)
    t = -b - s
    if t < 1e-6:
        t = -b + s
    return t if t > 1e-6 else None


def dist_to_seg(p, a, b):
    """点到线段的距离"""
    ab, ap = sub(b, a), sub(p, a)
    den = dot(ab, ab) or 1.0
    t = max(0.0, min(1.0, dot(ap, ab) / den))
    proj = add(a, scale(ab, t))
    return math.hypot(p[0] - proj[0], p[1] - proj[1])


def mirror_ends(el):
    """元件中心 + 角度 + 长度 → 两端点"""
    d = from_deg(el.get('angleDeg', 0))
    h = (el.get('length') or 110) / 2.0
    c = (el['cx'], el['cy'])
    return sub(c, scale(d, h)), add(c, scale(d, h))


def mirror_angle_for(din, dout):
    """已知入射方向和期望出射方向，求镜面摆放角（度）"""
    n = norm(sub(dout, din))
    return to_deg((-n[1], n[0]))


# ---------------------------------------------------------------- 颜色

class Color:
    R, G, B, W = 1, 2, 4, 7
    _MASK = {'R': 1, 'G': 2, 'B': 4, 'Y': 3, 'M': 5, 'C': 6, 'W': 7}
    _NAME = {1: '红', 2: '绿', 4: '蓝', 3: '黄', 5: '品红', 6: '青', 7: '白', 0: '任意'}
    _CHAR = {1: 'R', 2: 'G', 4: 'B', 3: 'Y', 5: 'M', 6: 'C', 7: 'W', 0: '?'}

    @staticmethod
    def mask(c):
        return Color._MASK.get(c, 7)

    @staticmethod
    def name(m):
        return Color._NAME.get(m, '任意')

    @staticmethod
    def char(m):
        return Color._CHAR.get(m, '?')


# ---------------------------------------------------------------- 偏振

class Pol:
    @staticmethod
    def wrap(deg):
        """归一化到 [0, 180)"""
        return (deg % 180 + 180) % 180

    @staticmethod
    def diff(a, b):
        """两个偏振方向的夹角，0~90"""
        d = Pol.wrap(a - b)
        return min(d, 180 - d)

    @staticmethod
    def match(a, b, tol=12):
        """目标无偏振要求则谁都行；光未起偏而目标有要求则不合格"""
        if b is None:
            return True
        if a is None:
            return False
        return Pol.diff(a, b) <= tol


# ---------------------------------------------------------------- 追踪

LOSS = {
    'mirror': 0.88, 'splitter': 0.50, 'prismSplit': 0.55, 'prismPass': 0.90,
    'filter': 0.85, 'portal': 0.95, 'lens': 0.92,
    'polarizer': 0.96, 'waveplate': 0.97,
}
ATTEN_PER_PX = 1.0 / 6000
DEFAULT_MIN_POWER = 0.10


def trace_light(source, elements, walls, targets, alarms):
    """追踪全部光束，返回判定结果。

    通关条件（全部同时满足）：
      1. 每个目标都被点亮（颜色严格匹配 + 能量达标 + 偏振合格）
      2. 没有任何一束光碰到禁区
      3. 每一个可动元件都真正参与了光路
    """
    walls = walls or []
    targets = targets or []
    alarms = alarms or []

    segs = [{'a': (w['a']['x'], w['a']['y']), 'b': (w['b']['x'], w['b']['y']),
             'type': 'wall', 'idx': -1} for w in walls]
    for i, el in enumerate(elements):
        a, b = mirror_ends(el)
        segs.append({'a': a, 'b': b, 'type': el['type'], 'idx': i})

    nT = len(targets)
    hit_tot = [{1: 0.0, 2: 0.0, 4: 0.0} for _ in range(nT)]   # 到达的总能量
    hit_ok = [{1: 0.0, 2: 0.0, 4: 0.0} for _ in range(nT)]    # 颜色 + 偏振都合格的能量
    got_pol = [{1: None, 2: None, 4: None} for _ in range(nT)]
    best_arr = [0.0] * nT
    got_mask = [0] * nT
    paths = []
    used = set()
    events = [[] for _ in elements]

    def rec(idx, ev):
        if 0 <= idx < len(events):
            events[idx].append(ev)

    def atten(d):
        return max(0.55, 1 - d * ATTEN_PER_PX)

    queue = [{
        'ro': (source['x'], source['y']),
        'rd': norm(from_deg(source.get('angleDeg', 0))),
        'color': Color.mask(source.get('color', 'W')),
        'power': 1.0,
        'pol': None if source.get('pol') is None else Pol.wrap(source['pol']),
    }]

    guard = 0
    while queue and guard < 900:
        guard += 1
        beam = queue.pop(0)
        ro, rd = beam['ro'], beam['rd']
        color, power, pol = beam['color'], beam['power'], beam['pol']
        pts = [ro]
        powers = [power]
        pols = [pol]
        idx_list = []
        bounces = 0

        while bounces < 60:
            bounces += 1
            best_t, best_p, best_n, best_type, best_idx = float('inf'), None, None, None, -1
            for s in segs:
                h = ray_seg(ro, rd, s['a'], s['b'])
                if h and h[0] < best_t:
                    best_t, best_p, best_n = h[0], h[1], h[2]
                    best_type, best_idx = s['type'], s['idx']

            t_hit, t_t = -1, float('inf')
            for ti, tg in enumerate(targets):
                tc = ray_circle(ro, rd, (tg['x'], tg['y']), tg['r'])
                if tc is not None and tc < t_t:
                    t_t, t_hit = tc, ti

            if t_hit >= 0 and t_t < best_t:
                arrive = power * atten(t_t)
                pts.append(add(ro, scale(rd, t_t)))
                tg = targets[t_hit]
                need_pol = None if tg.get('needPol') is None else Pol.wrap(tg['needPol'])
                tol = tg.get('polTol', 12)
                need_c = 0 if tg.get('required') == 'ANY' else Color.mask(tg.get('required'))
                color_ok = (need_c == 0) or (color == need_c)
                ok = color_ok and Pol.match(pol, need_pol, tol)
                if arrive > best_arr[t_hit]:
                    best_arr[t_hit] = arrive
                    got_mask[t_hit] = color
                for m in (1, 2, 4):
                    if not (color & m):
                        continue
                    cur = got_pol[t_hit][m]
                    if cur is None or arrive > hit_tot[t_hit][m]:
                        got_pol[t_hit][m] = pol
                    hit_tot[t_hit][m] += arrive
                    if ok:
                        hit_ok[t_hit][m] += arrive
                break

            if best_type is None:
                pts.append(add(ro, scale(rd, 2600)))
                break

            pts.append(best_p)
            power *= atten(best_t)
            if best_idx >= 0:
                used.add(best_idx)
                idx_list.append(best_idx)

            if best_type == 'wall':
                break

            p_in, d_in, c_in, pol_in = power, rd, color, pol

            def done(kind, **extra):
                ev = {'kind': kind, 'at': best_p, 'inDir': d_in, 'inColor': c_in,
                      'inPower': p_in, 'inPol': pol_in,
                      'outColor': color, 'outPower': power, 'outPol': pol}
                ev.update(extra)
                return ev

            if best_type == 'mirror':
                power *= LOSS['mirror']
                rd = reflect(rd, best_n)
                rec(best_idx, done('reflect', outDir=rd))
                ro = add(best_p, scale(rd, 0.1))
                powers.append(power)
                pols.append(pol)
                continue

            if best_type == 'splitter':
                rrd = reflect(rd, best_n)
                half = power * LOSS['splitter']
                rec(best_idx, done('split', outDir=rd, outPower=half))
                queue.append({'ro': add(best_p, scale(rd, 0.1)), 'rd': rd,
                              'color': color, 'power': half, 'pol': pol})
                queue.append({'ro': add(best_p, scale(rrd, 0.1)), 'rd': rrd,
                              'color': color, 'power': half, 'pol': pol})
                break

            if best_type == 'prism':
                if color == 7:
                    da = math.radians(11)
                    rec(best_idx, done('disperse', outDir=rd,
                                       outPower=power * LOSS['prismSplit'], outColor=7))
                    for c, off in ((1, -da), (2, 0.0), (4, da)):
                        nd = rotate(rd, off)
                        queue.append({'ro': add(best_p, scale(nd, 0.1)), 'rd': nd,
                                      'color': c, 'power': power * LOSS['prismSplit'], 'pol': pol})
                    break
                else:
                    power *= LOSS['prismPass']
                    rec(best_idx, done('pass', outDir=rd))
                    ro = add(best_p, scale(rd, 0.1))
                    powers.append(power)
                    pols.append(pol)
                    continue

            if best_type == 'filter':
                fc = Color.mask(elements[best_idx].get('color', 'R'))
                if not (color & fc):
                    rec(best_idx, done('blocked', blocked=True, outColor=0, outPower=0))
                    break
                power *= LOSS['filter']
                color = fc
                rec(best_idx, done('color', outDir=rd))
                ro = add(best_p, scale(rd, 0.1))
                powers.append(power)
                pols.append(pol)
                continue

            if best_type == 'portal':
                me = elements[best_idx]
                p_idx = -1
                for i, el in enumerate(elements):
                    if i != best_idx and el['type'] == 'portal' and el.get('portalId') == me.get('portalId'):
                        p_idx = i
                        break
                if p_idx < 0:
                    ro = add(best_p, scale(rd, 0.1))
                    powers.append(power)
                    pols.append(pol)
                    continue
                partner = elements[p_idx]
                pa, pb = mirror_ends(partner)
                pc = ((pa[0] + pb[0]) / 2, (pa[1] + pb[1]) / 2)
                used.add(p_idx)
                idx_list.append(p_idx)
                power *= LOSS['portal']
                rec(best_idx, done('teleport', outDir=rd, partner=p_idx))
                rec(p_idx, {'kind': 'emit', 'at': pc, 'inDir': rd, 'outDir': rd,
                            'inColor': color, 'outColor': color,
                            'inPower': power, 'outPower': power,
                            'inPol': pol, 'outPol': pol})
                ro = add(pc, scale(rd, (partner.get('length') or 110) / 2 + 1))
                powers.append(power)
                pols.append(pol)
                continue

            if best_type == 'lens':
                el = elements[best_idx]
                f = el.get('focal') or 200
                center = (el['cx'], el['cy'])
                s = 1 if dot(rd, best_n) >= 0 else -1
                A = scale(best_n, s)
                Hv = (-A[1], A[0])
                dA = dot(rd, A)
                if abs(dA) < 1e-6:
                    ro = add(best_p, scale(rd, 0.1))
                    powers.append(power)
                    pols.append(pol)
                    continue
                yh = dot(sub(best_p, center), Hv)
                m = dot(rd, Hv) / dA
                nd = norm((A[0] + Hv[0] * (m - yh / f), A[1] + Hv[1] * (m - yh / f)))
                power *= LOSS['lens']
                rd = nd
                rec(best_idx, done('focus', outDir=rd))
                ro = add(best_p, scale(nd, 0.1))
                powers.append(power)
                pols.append(pol)
                continue

            if best_type == 'polarizer':
                axis = Pol.wrap(elements[best_idx].get('axisDeg', 0))
                if pol is None:                       # 自然光起偏：能量减半
                    power *= LOSS['polarizer'] * 0.5
                    pol = axis
                else:                                 # 马吕斯定律 I' = I·cos^2(θ - 轴)
                    c = math.cos(math.radians(pol - axis))
                    power *= LOSS['polarizer'] * c * c
                    pol = axis
                rec(best_idx, done('polarize', outDir=rd, axis=axis))
                ro = add(best_p, scale(rd, 0.1))
                powers.append(power)
                pols.append(pol)
                continue

            if best_type == 'waveplate':
                fast = Pol.wrap(elements[best_idx].get('axisDeg', 0))
                if pol is not None:                   # θ' = 2·快轴 - θ
                    pol = Pol.wrap(2 * fast - pol)
                    power *= LOSS['waveplate']
                rec(best_idx, done('rotate', outDir=rd, axis=fast))
                ro = add(best_p, scale(rd, 0.1))
                powers.append(power)
                pols.append(pol)
                continue

            break

        paths.append({'pts': pts, 'color': color, 'powers': powers,
                      'pols': pols, 'idxList': idx_list})

    # 禁区：任一束光擦到即判负
    alarmed = False
    if alarms:
        for p in paths:
            for i in range(len(p['pts']) - 1):
                for z in alarms:
                    if dist_to_seg((z['x'], z['y']), p['pts'][i], p['pts'][i + 1]) <= z['r']:
                        alarmed = True
                        break
                if alarmed:
                    break
            if alarmed:
                break

    # 逐目标判定
    detail = []
    for i, t in enumerate(targets):
        thr = t.get('minPower') if t.get('minPower') is not None else DEFAULT_MIN_POWER
        need = 0 if t.get('required') == 'ANY' else Color.mask(t.get('required'))
        need_pol = None if t.get('needPol') is None else Pol.wrap(t['needPol'])
        if need == 0:
            v = max(hit_ok[i][1], hit_ok[i][2], hit_ok[i][4])
            vt = max(hit_tot[i][1], hit_tot[i][2], hit_tot[i][4])
            detail.append({'lit': v >= thr, 'got': v, 'gotTot': vt, 'thr': thr,
                           'need': 0, 'needPol': need_pol, 'gotPol': None,
                           'colorOK': True, 'gotMask': got_mask[i], 'comps': [1, 2, 4]})
            continue
        comps = [m for m in (1, 2, 4) if need & m]
        vals = [hit_ok[i][m] for m in comps]
        tots = [hit_tot[i][m] for m in comps]
        detail.append({
            'lit': all(x >= thr for x in vals),
            'got': min(vals) if vals else 0.0,
            'gotTot': min(tots) if tots else 0.0,
            'thr': thr, 'need': need, 'needPol': need_pol,
            'gotPol': [got_pol[i][m] for m in comps],
            'colorOK': got_mask[i] == need,
            'gotMask': got_mask[i], 'comps': comps,
        })
    lit = [d['lit'] for d in detail]

    eff = 1.0
    for d in detail:
        eff = min(eff, d['got'])

    movable = []
    for i, el in enumerate(elements):
        is_mov = el['movable'] if el.get('movable') is not None else (not el.get('fixed'))
        if is_mov:
            movable.append({'idx': i, 'used': i in used})
    activated = sum(1 for m in movable if m['used'])

    won = (not alarmed) and all(lit) and activated >= len(movable) and len(movable) > 0

    bounces = 0
    path_len = 0.0
    for p in paths:
        bounces += max(0, len(p['pts']) - 2)
        for i in range(len(p['pts']) - 1):
            path_len += math.hypot(p['pts'][i + 1][0] - p['pts'][i][0],
                                   p['pts'][i + 1][1] - p['pts'][i][1])

    return {'paths': paths, 'detail': detail, 'lit': lit, 'won': won,
            'alarmed': alarmed, 'eff': eff, 'activated': activated,
            'movableTotal': len(movable), 'movable': movable, 'events': events,
            'bounces': bounces, 'pathLen': path_len}


# ============================================================ ASCII 棋盘渲染



WORLD_W, WORLD_H = 1000.0, 640.0


def _size(want_cols=None):
    """按终端宽度自适应；窄了不会折行"""
    if want_cols:
        cols = want_cols
    else:
        try:
            cols = shutil.get_terminal_size((100, 30)).columns - 4
        except Exception:
            cols = 100
        cols = max(60, min(100, cols))
    return cols, max(18, int(round(cols * 0.32)))


COLS, ROWS = _size()

# 元件类型 → 显示字符 / 中文名
PART_CHAR = {
    'mirror': '-', 'splitter': 'S', 'prism': 'D', 'filter': 'F',
    'polarizer': 'A', 'waveplate': 'H', 'lens': 'O', 'portal': 'T',
}
PART_NAME = {
    'mirror': '镜子', 'splitter': '分光镜', 'prism': '棱镜', 'filter': '滤色片',
    'polarizer': '偏振片', 'waveplate': '半波片', 'lens': '凸透镜', 'portal': '传送门',
}


def _col(x):
    return max(0, min(COLS - 1, int(x / WORLD_W * COLS)))


def _row(y):
    return max(0, min(ROWS - 1, int(y / WORLD_H * ROWS)))


def _angle_char(deg):
    """镜子按摆放角度选字符（注意屏幕 y 轴向下）"""
    a = deg % 180
    if a < 22.5 or a >= 157.5:
        return '-'
    if a < 67.5:
        return '\\'
    if a < 112.5:
        return '|'
    return '/'


def _plot(grid, p, ch, force=False):
    c, r = _col(p[0]), _row(p[1])
    if force or grid[r][c] == ' ':
        grid[r][c] = ch


def _plot_seg(grid, a, b, ch, force=False):
    steps = int(max(abs(b[0] - a[0]), abs(b[1] - a[1])) / 2) + 1
    for i in range(steps + 1):
        t = i / steps
        _plot(grid, (a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t), ch, force)


def _plot_circle(grid, c, r_world, ch, force=False):
    for i in range(48):
        ang = 2 * math.pi * i / 48
        _plot(grid, (c[0] + r_world * math.cos(ang), c[1] + r_world * math.sin(ang)), ch, force)


def render(level, elements, result):
    """返回字符画字符串"""
    grid = [[' '] * COLS for _ in range(ROWS)]

    # 1. 光路（画在最底层）
    for p in result['paths']:
        ch = Color.char(p['color'])
        for i in range(len(p['pts']) - 1):
            _plot_seg(grid, p['pts'][i], p['pts'][i + 1], ch)

    # 2. 墙
    for w in level.get('walls') or []:
        a = (w['a']['x'], w['a']['y'])
        b = (w['b']['x'], w['b']['y'])
        _plot_seg(grid, a, b, '#', force=True)

    # 3. 禁区
    for z in level.get('alarms') or []:
        mark = 'X' if result['alarmed'] else 'x'
        _plot_circle(grid, (z['x'], z['y']), z['r'], mark, force=True)

    # 4. 元件
    for i, el in enumerate(elements):
        a, b = mirror_ends(el)
        ch = _angle_char(el.get('angleDeg', 0)) if el['type'] == 'mirror' else PART_CHAR.get(el['type'], '?')
        if el.get('movable'):
            ch = ch  # 可动元件用小写/符号区分不开，改为在清单里标编号
        _plot_seg(grid, a, b, ch, force=True)

    # 5. 目标（未亮 (n) / 已亮 [n]）
    for i, t in enumerate(level.get('targets') or []):
        lit = result['lit'][i]
        txt = '[%d]' % (i + 1) if lit else '(%d)' % (i + 1)
        r = _row(t['y'])
        c = _col(t['x']) - 1
        for k, chx in enumerate(txt):
            cc = c + k
            if 0 <= cc < COLS:
                grid[r][cc] = chx

    # 6. 光源
    src = level['source']
    _plot(grid, (src['x'], src['y']), '@', force=True)

    top = '+' + '-' * COLS + '+'
    body = ['|' + ''.join(row) + '|' for row in grid]
    return '\n'.join([top] + body + [top])


def legend():
    return ('字符含义： @ 光源   # 墙   x 禁区(碰不得)   (1) 目标未亮   [1] 目标已亮\n'
            '          - \\ | / 镜子   S 分光镜   D 棱镜   F 滤色片   A 偏振片\n'
            '          H 半波片   O 凸透镜   T 传送门\n'
            '光路颜色： R 红  G 绿  B 蓝  Y 黄  C 青  M 品红  W 白')


# ============================================================ 交互主循环




def clear():
    print('\n' + '=' * 78 + '\n')


class Game:
    def __init__(self):
        self.idx = 0
        self.hints = 0
        self.steps = 0
        self.load(0)

    # ------------------------------------------------------------ 关卡

    def load(self, i):
        n = len(LEVELS)
        self.idx = max(0, min(n - 1, i))
        self.level = LEVELS[self.idx]
        self.elements = copy.deepcopy(self.level.get('elements') or [])
        self.steps = 0
        self.won = False
        return self.level

    def movable(self):
        """返回 [(编号, 元件字典, 在 elements 里的下标)]，编号从 1 开始"""
        out = []
        k = 0
        for i, el in enumerate(self.elements):
            is_mov = el['movable'] if el.get('movable') is not None else (not el.get('fixed'))
            if is_mov:
                k += 1
                out.append((k, el, i))
        return out

    def trace(self):
        lv = self.level
        return trace_light(
            lv['source'], self.elements,
            lv.get('walls'), lv.get('targets'), lv.get('alarms'))

    # ------------------------------------------------------------ 输出

    def header(self):
        lv = self.level
        print('  LightMaze 第 %d / %d 关 · %s' % (self.idx + 1, len(LEVELS), lv['name']))
        print('  ' + (lv.get('tag') or ''))
        if lv.get('intro'):
            print('  ' + lv['intro'])

    def board(self, res):
        print(render(self.level, self.elements, res))
        print(legend())

    def conditions(self, res):
        print('  ── 通关条件 ──')
        for i, d in enumerate(res['detail']):
            t = self.level['targets'][i]
            pct = int(round(d['got'] * 100))
            thr = int(round(d['thr'] * 100))
            need = '任意光' if d['need'] == 0 else Color.name(d['need']) + '光'
            if d['lit']:
                mark, why = '[OK]', '已点亮'
            else:
                mark, why = '[  ]', self.diagnose(d)
            pol = ''
            if d['needPol'] is not None:
                got = d['gotPol'][0] if d['gotPol'] else None
                pol = '  偏振 %s/需 %d°' % (
                    ('%d°' % round(Pol.wrap(got))) if got is not None else '未起偏',
                    round(d['needPol']))
            print('   %s 目标 %d  %s  能量 %d%%/需 %d%%%s   %s'
                  % (mark, i + 1, need, pct, thr, pol, why))

        tot = res['movableTotal']
        ok = res['activated'] >= tot and tot > 0
        print('   %s 可动元件 %d/%d 已参与光路' % ('[OK]' if ok else '[  ]', res['activated'], tot))
        if res['alarmed']:
            print('   [XX] 有光束碰到禁区 —— 立刻判负')

    def diagnose(self, d):
        """按优先级说出卡在哪一步"""
        if d['gotTot'] <= 1e-6:
            return '光还没到达'
        if not d['colorOK']:
            arrived = Color.name(d['gotMask']) if d['gotMask'] else '杂色'
            need = '任意' if d['need'] == 0 else Color.name(d['need'])
            return '颜色不对（到的是%s光，要%s光）' % (arrived, need)
        if d['needPol'] is not None:
            got = d['gotPol'][0] if d['gotPol'] else None
            if got is None or not Pol.match(got, d['needPol']):
                if got is None:
                    return '光还没起偏（先让它过偏振片）'
                diff = round(Pol.diff(got, d['needPol']))
                return '偏振差 %d°（要压到 12° 内）' % diff
        if d['got'] < d['thr']:
            return '能量还差 %d 个百分点' % int(round((d['thr'] - d['got']) * 100))
        return '尚未满足'

    def parts(self, res):
        print('  ── 可动元件 ──')
        used = {m['idx'] for m in res['movable'] if m['used']}
        for k, el, i in self.movable():
            tag = 'OK 在光路上' if i in used else '-- 还没用到'
            line = '   %d  %s  位置(%d,%d)  角度 %s°' % (
                k, PART_NAME.get(el['type'], el['type']),
                el['cx'], el['cy'], round(el.get('angleDeg', 0), 1))
            if el.get('axisDeg') is not None:
                line += '  轴/快轴 %s°' % round(el['axisDeg'], 1)
            if el.get('color'):
                line += '  颜色 %s' % Color.name(Color.mask(el['color']))
            print(line + '   ' + tag)
        fixed = [(i, el) for i, el in enumerate(self.elements)
                 if not (el['movable'] if el.get('movable') is not None else (not el.get('fixed')))]
        if fixed:
            print('  固定件：' + '、'.join(
                '%s(%d,%d)' % (PART_NAME.get(el['type'], el['type']), el['cx'], el['cy'])
                for _, el in fixed))

    def show(self, full=True):
        clear()
        res = self.trace()
        self.header()
        print()
        self.board(res)
        print()
        self.conditions(res)
        print()
        self.parts(res)
        print()
        if res['won'] and not self.won:
            self.won = True
            print('  >>> 通关！用 %d 步，效率 %d%%' % (self.steps, int(round(res['eff'] * 100))))
            print('      输入 n 进入下一关，或继续调整研究光路')
        print('  ' + '─' * 74)
        print('  rot 编号 角度 | pos 编号 x y | axis 编号 角度 | list | sol | auto | reset | n | b | q')
        return res

    # ------------------------------------------------------------ 指令

    def run(self):
        print('=' * 78)
        print('   LightMaze · 偏振光路解谜（Python 控制台版）')
        print('   输入 help 看全部指令，输入 q 退出')
        print('=' * 78)
        self.show()
        while True:
            try:
                raw = input('\n  指令 > ').strip()
            except (EOFError, KeyboardInterrupt):
                print('\n  再见。')
                return
            if not raw:
                self.show()
                continue
            cmd = raw.split()
            op = cmd[0].lower()
            try:
                if op in ('q', 'quit', 'exit'):
                    print('  再见。')
                    return
                elif op in ('h', 'help'):
                    self.help()
                elif op in ('l', 'list'):
                    self.parts(self.trace())
                elif op in ('rot', 'r'):
                    self.cmd_rot(cmd[1:])
                elif op in ('pos', 'm', 'move'):
                    self.cmd_pos(cmd[1:])
                elif op in ('axis', 'a'):
                    self.cmd_axis(cmd[1:])
                elif op == 'sol':
                    self.cmd_sol()
                elif op == 'auto':
                    self.cmd_auto()
                elif op in ('reset', 'x'):
                    self.load(self.idx)
                    self.show()
                elif op in ('n', 'next'):
                    self.load(self.idx + 1)
                    self.show()
                elif op in ('b', 'prev', 'back'):
                    self.load(self.idx - 1)
                    self.show()
                elif op == 'go':
                    self.load(int(cmd[1]) - 1)
                    self.show()
                else:
                    print('  没这个指令：%s（输入 help 看全部）' % op)
            except (ValueError, IndexError):
                print('  参数不对，格式见 help')

    def pick(self, arg):
        k = int(arg)
        for num, el, i in self.movable():
            if num == k:
                return el
        raise ValueError('没有 %d 号元件（输入 list 看编号）' % k)

    def cmd_rot(self, args):
        el = self.pick(args[0])
        v = args[1]
        if v.startswith('+') or v.startswith('-'):
            el['angleDeg'] = el.get('angleDeg', 0) + float(v)
        else:
            el['angleDeg'] = float(v)
        self.steps += 1
        self.show()

    def cmd_pos(self, args):
        el = self.pick(args[0])
        el['cx'], el['cy'] = float(args[1]), float(args[2])
        self.steps += 1
        self.show()

    def cmd_axis(self, args):
        el = self.pick(args[0])
        if el.get('axisDeg') is None:
            print('  %s 没有轴向可调（只有偏振片和半波片有）'
                  % PART_NAME.get(el['type'], el['type']))
            return
        el['axisDeg'] = float(args[1])
        self.steps += 1
        self.show()

    def cmd_sol(self):
        sol = self.level.get('solution') or []
        self.hints += 1
        print('  标准解（已用提示 %d 次）：' % self.hints)
        for k, (num, el, i) in enumerate(self.movable()):
            if k < len(sol):
                s = sol[k]
                print('    %d 号 → 位置(%d,%d)  角度 %s°'
                      % (num, round(s['cx']), round(s['cy']), round(s['angleDeg'], 1)))

    def cmd_auto(self):
        sol = self.level.get('solution') or []
        for k, (num, el, i) in enumerate(self.movable()):
            if k < len(sol):
                el['cx'], el['cy'] = sol[k]['cx'], sol[k]['cy']
                el['angleDeg'] = sol[k]['angleDeg']
        print('  已按标准解摆好（这一步算作弊，用来看正解长什么样）')
        self.show()

    def help(self):
        print('''
  指令一览（大小写都行）
  ------------------------------------------------------------------
  rot 编号 角度     把元件转到指定角度，例：rot 1 45
  rot 编号 +5       在当前角度上加减，例：rot 1 -5
  pos 编号 x y      把元件移到指定坐标，例：pos 1 400 300
  axis 编号 角度    设偏振片透振方向 / 半波片快轴，例：axis 2 90

  list              列出全部可动元件的编号、位置、角度、是否参与光路
  sol               显示本关标准解（记一次提示）
  auto              直接按标准解摆好（看正解用）
  reset             本关重置
  n / b             下一关 / 上一关
  go 编号           直接跳到第几关，例：go 7
  q                 退出
  ------------------------------------------------------------------
  通关要同时满足：全部目标点亮 + 不碰禁区 + 每块可动元件都参与光路
''')


def main():
    try:
        Game().run()
    except KeyboardInterrupt:
        print('\n  再见。')
        sys.exit(0)


if __name__ == '__main__':
    main()
